# 이 파일을 secrets.properties로 복사해 실제 값을 채운다.
#   cp secrets.properties.template secrets.properties
# secrets.properties는 .gitignore로 커밋 제외(iOS Sensitive.xcconfig 대응).

# Supabase (기존 백엔드)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# 소셜 로그인
KAKAO_NATIVE_APP_KEY=your-kakao-native-app-key
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# 릴리스 서명(업로드 키). 키스토어는 저장소 밖 경로에 두고 절대 커밋하지 않는다.
RELEASE_STORE_FILE=/absolute/path/to/mutter-upload.jks
RELEASE_STORE_PASSWORD=your-keystore-password
RELEASE_KEY_ALIAS=mutter-upload
RELEASE_KEY_PASSWORD=your-key-password
